    <string name="step_dev_options">1 · Enable developer options on the watch</string>
    <string name="step_dev_options_body">On the watch: Settings → System → About → Versions, then tap “Build number” 7 times.</string>
    <string name="step_wireless">2 · Turn on Wireless debugging</string>
    <string name="step_wireless_body">Settings → Developer options → turn on “ADB debugging” and “Wireless debugging”. Watch and phone must be on the same Wi-Fi.</string>
    <string name="step_pair">3 · Pair (first time only)</string>
    <string name="step_pair_body">On the watch tap “Pair new device”. Enter the 6-digit code shown there. ScoreUp finds the watch’s address automatically.</string>
    <string name="step_install">4 · Install</string>
    <string name="step_install_body">The watch shows an “Allow debugging?” prompt the first time — tap Allow.</string>
